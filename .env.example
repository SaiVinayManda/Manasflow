# Optional lead & newsletter delivery (configure webhook, CRM, or Resend in Vercel)
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
CRM_WEBHOOK_URL=
LEAD_PERSISTENCE_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=

# Optional Resend transactional email delivery & customer confirmation
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=info@manasflow.com
RESEND_ENABLE_CONFIRMATION=false

# Optional Supabase REST persistence (persist leads before webhook/email notifications)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=manasflow_leads
SUPABASE_NEWSLETTER_TABLE=manasflow_newsletter

# Optional Cal.com webhook signature verification (HMAC-SHA256 secret)
CAL_WEBHOOK_SECRET=

# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
